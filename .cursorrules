## XVIII. ANTI-PATTERNS

```js
// ✗ Import ui/* trực tiếp từ page
import { Button } from '@/components/ui/button';

// ✗ Flat lib mới ở root
import x from '@/lib/bannerUtils';

// ✗ Mutation không check quyền
export async function deleteX(id) { await apiDelete(`/x/${id}`); }

// ✗ Filter bar copy-paste buildHref — dùng useListUrlFilters

// ✗ List table style inline lặp lại — dùng listTableStyles + module *ListTableStyles

// ✗ Bypass ADMIN
if (role_type === 'ADMIN') return true;

// ✗ Dynamic Tailwind class (JIT không scan)
const cls = `min-w-[${width}px]`;
```

