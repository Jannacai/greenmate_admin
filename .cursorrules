│   │   ├── collections/           — tương tự
│   │   ├── inventory/             — nguyên liệu / tồn kho
│   │   ├── customers/, staff/, rbac/
│   │   └── orders/, reviews/…     — chưa implement (nav có thể ẩn sau)
│   ├── api/auth/session-clear/
